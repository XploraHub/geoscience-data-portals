{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Geoscience data portal",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "agency", "jurisdiction", "level", "homepage", "status", "summary", "data_types", "access", "licence", "sources", "last_verified", "verified_by"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 2 },
    "agency": { "type": "string", "minLength": 2 },
    "jurisdiction": { "type": "string", "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$", "description": "ISO 3166-1 alpha-2, or ISO 3166-2 for a state or province" },
    "level": { "enum": ["national", "state", "province", "territory", "regional"] },
    "homepage": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "status": { "enum": ["active", "uncertain", "deprecated", "superseded"] },
    "superseded_by": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "summary": { "type": "string", "minLength": 20, "maxLength": 300 },
    "language": { "type": "array", "items": { "type": "string", "pattern": "^[a-z]{2}$" }, "minItems": 1 },
    "data_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "geological-maps", "mineral-occurrences", "drillholes", "drillhole-assays", "surface-geochemistry",
          "magnetics", "gravity", "radiometrics", "electromagnetics", "magnetotellurics", "seismic",
          "company-reports", "tenements", "remote-sensing", "geochronology", "petrophysics",
          "core-library", "3d-models", "publications", "elevation"
        ]
      }
    },
    "formats": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
    "access": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "url", "auth"],
        "properties": {
          "method": { "enum": ["viewer", "download", "bulk-download", "wms", "wfs", "wcs", "wmts", "arcgis-rest", "ogc-api", "ckan", "stac", "ftp", "order", "email-request", "api"] },
          "url": { "type": "string", "format": "uri", "pattern": "^(https?|ftp)://" },
          "auth": { "enum": ["none", "free-registration", "paid", "restricted"] },
          "notes": { "type": "string" }
        }
      }
    },
    "licence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "description": "SPDX id where one exists, otherwise LicenseRef-<name> or 'unstated'" },
        "url": { "type": "string", "format": "uri" },
        "notes": { "type": "string" }
      }
    },
    "open_file_after": { "type": "integer", "minimum": 0, "maximum": 50, "description": "Minimum years before company reports or data become public, where the portal states it; release rules go in caveats" },
    "caveats": { "type": "array", "items": { "type": "string", "minLength": 10 } },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri", "pattern": "^https?://" } },
    "aggregated_by": { "type": "array", "items": { "enum": ["auscope", "egdi", "onegeology", "sciencebase", "data-gov-au", "open-canada"] } },
    "last_verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "verified_by": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "superseded" } } }, "then": { "required": ["superseded_by"] } }
  ]
}
